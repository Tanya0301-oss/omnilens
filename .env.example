# OmniLens environment variables
# Copy this file to .env and fill in real values — NEVER commit .env to git.

# --- Groq API (Step 3 — generation) ---
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Choose a model from your Groq account — run `python test_llm.py --list-models` to see all options.
GROQ_MODEL=llama3-70b-8192
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b


# --- Application settings ---
LOG_LEVEL=INFO
UPLOADS_DIR=data/uploads
CHROMA_DIR=data/chroma_db
SQLITE_DB_PATH=data/omnilens.db
CACHE_DIR=data/cache
